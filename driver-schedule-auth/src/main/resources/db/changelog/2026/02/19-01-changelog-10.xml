<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd"
  objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
  <changeSet id="1771514041901-1" author="mmoya@PragmaInvest.com">
    <createTable tableName="clients">
      <column defaultValueComputed="uuid_generate_v4()" name="id" type="uuid">
        <constraints nullable="false" primaryKey="true" primaryKeyName="pk_clients"/>
      </column>
      <column defaultValueComputed="now()" name="created_at" type="timestamp">
        <constraints nullable="false"/>
      </column>
      <column name="created_by" type="VARCHAR(255)"/>
      <column defaultValueComputed="now()" name="updated_at" type="timestamp">
        <constraints nullable="false"/>
      </column>
      <column name="updated_by" type="VARCHAR(255)"/>
      <column defaultValueNumeric="0" name="version" type="bigint">
        <constraints nullable="false"/>
      </column>
      <column defaultValueBoolean="false" name="deleted" type="boolean">
        <constraints nullable="false"/>
      </column>
      <column name="client_id" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="client_secret" type="VARCHAR(255)"/>
      <column name="web_origins" type="VARCHAR(255)"/>
    </createTable>
  </changeSet>
  <changeSet id="1771514041901-2" author="mmoya@PragmaInvest.com">
    <createTable tableName="realm_clients">
      <column defaultValueComputed="uuid_generate_v4()" name="id" type="uuid">
        <constraints nullable="false" primaryKey="true" primaryKeyName="pk_realm_clients"/>
      </column>
      <column defaultValueComputed="now()" name="created_at" type="timestamp">
        <constraints nullable="false"/>
      </column>
      <column name="created_by" type="VARCHAR(255)"/>
      <column defaultValueComputed="now()" name="updated_at" type="timestamp">
        <constraints nullable="false"/>
      </column>
      <column name="updated_by" type="VARCHAR(255)"/>
      <column defaultValueNumeric="0" name="version" type="bigint">
        <constraints nullable="false"/>
      </column>
      <column defaultValueBoolean="false" name="deleted" type="boolean">
        <constraints nullable="false"/>
      </column>
      <column name="realm_id" type="UUID">
        <constraints nullable="false"/>
      </column>
      <column name="client_id" type="UUID">
        <constraints nullable="false"/>
      </column>
    </createTable>
  </changeSet>
  <changeSet id="1771514041901-3" author="mmoya@PragmaInvest.com">
    <createTable tableName="role_scopes">
      <column defaultValueComputed="uuid_generate_v4()" name="id" type="uuid">
        <constraints nullable="false" primaryKey="true" primaryKeyName="pk_role_scopes"/>
      </column>
      <column defaultValueComputed="now()" name="created_at" type="timestamp">
        <constraints nullable="false"/>
      </column>
      <column name="created_by" type="VARCHAR(255)"/>
      <column defaultValueComputed="now()" name="updated_at" type="timestamp">
        <constraints nullable="false"/>
      </column>
      <column name="updated_by" type="VARCHAR(255)"/>
      <column defaultValueNumeric="0" name="version" type="bigint">
        <constraints nullable="false"/>
      </column>
      <column defaultValueBoolean="false" name="deleted" type="boolean">
        <constraints nullable="false"/>
      </column>
      <column name="role_id" type="UUID">
        <constraints nullable="false"/>
      </column>
      <column name="scope_id" type="UUID">
        <constraints nullable="false"/>
      </column>
    </createTable>
  </changeSet>
  <changeSet id="1771514041901-4" author="mmoya@PragmaInvest.com">
    <createTable tableName="scopes">
      <column defaultValueComputed="uuid_generate_v4()" name="id" type="uuid">
        <constraints nullable="false" primaryKey="true" primaryKeyName="pk_scopes"/>
      </column>
      <column defaultValueComputed="now()" name="created_at" type="timestamp">
        <constraints nullable="false"/>
      </column>
      <column name="created_by" type="VARCHAR(255)"/>
      <column defaultValueComputed="now()" name="updated_at" type="timestamp">
        <constraints nullable="false"/>
      </column>
      <column name="updated_by" type="VARCHAR(255)"/>
      <column defaultValueNumeric="0" name="version" type="bigint">
        <constraints nullable="false"/>
      </column>
      <column defaultValueBoolean="false" name="deleted" type="boolean">
        <constraints nullable="false"/>
      </column>
      <column name="name" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
    </createTable>
  </changeSet>
  <changeSet id="1771514041901-5" author="mmoya@PragmaInvest.com">
    <addUniqueConstraint columnNames="client_id" constraintName="uc_clients_client"
      tableName="clients"/>
  </changeSet>
  <changeSet id="1771514041901-6" author="mmoya@PragmaInvest.com">
    <addForeignKeyConstraint baseColumnNames="client_id" baseTableName="realm_clients"
      constraintName="FK_REALM_CLIENTS_ON_CLIENT" referencedColumnNames="id"
      referencedTableName="clients"/>
  </changeSet>
  <changeSet id="1771514041901-7" author="mmoya@PragmaInvest.com">
    <addForeignKeyConstraint baseColumnNames="realm_id" baseTableName="realm_clients"
      constraintName="FK_REALM_CLIENTS_ON_REALM" referencedColumnNames="id"
      referencedTableName="realms"/>
  </changeSet>
  <changeSet id="1771514041901-8" author="mmoya@PragmaInvest.com">
    <addForeignKeyConstraint baseColumnNames="role_id" baseTableName="role_scopes"
      constraintName="FK_ROLE_SCOPES_ON_ROLE" referencedColumnNames="id"
      referencedTableName="roles"/>
  </changeSet>
  <changeSet id="1771514041901-9" author="mmoya@PragmaInvest.com">
    <addForeignKeyConstraint baseColumnNames="scope_id" baseTableName="role_scopes"
      constraintName="FK_ROLE_SCOPES_ON_SCOPE" referencedColumnNames="id"
      referencedTableName="scopes"/>
  </changeSet>

</databaseChangeLog>