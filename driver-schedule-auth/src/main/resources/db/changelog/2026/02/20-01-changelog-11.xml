<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd"
  objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
  <changeSet id="1771595367473-1" author="mmoya@PragmaInvest.com">
    <createTable tableName="audiences">
      <column defaultValueComputed="uuid_generate_v4()" name="id" type="uuid">
        <constraints nullable="false" primaryKey="true" primaryKeyName="pk_audiences"/>
      </column>
      <column defaultValueComputed="now()" name="created_at" type="timestamp">
        <constraints nullable="false"/>
      </column>
      <column name="created_by" type="VARCHAR(255)"/>
      <column defaultValueComputed="now()" name="updated_at" type="timestamp">
        <constraints nullable="false"/>
      </column>
      <column name="updated_by" type="VARCHAR(255)"/>
      <column defaultValueNumeric="0" name="version" type="bigint">
        <constraints nullable="false"/>
      </column>
      <column defaultValueBoolean="false" name="deleted" type="boolean">
        <constraints nullable="false"/>
      </column>
      <column name="name" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
    </createTable>
  </changeSet>
  <changeSet id="1771595367473-2" author="mmoya@PragmaInvest.com">
    <createTable tableName="client_audiences">
      <column defaultValueComputed="uuid_generate_v4()" name="id" type="uuid">
        <constraints nullable="false" primaryKey="true" primaryKeyName="pk_client_audiences"/>
      </column>
      <column defaultValueComputed="now()" name="created_at" type="timestamp">
        <constraints nullable="false"/>
      </column>
      <column name="created_by" type="VARCHAR(255)"/>
      <column defaultValueComputed="now()" name="updated_at" type="timestamp">
        <constraints nullable="false"/>
      </column>
      <column name="updated_by" type="VARCHAR(255)"/>
      <column defaultValueNumeric="0" name="version" type="bigint">
        <constraints nullable="false"/>
      </column>
      <column defaultValueBoolean="false" name="deleted" type="boolean">
        <constraints nullable="false"/>
      </column>
      <column name="client_id" type="UUID">
        <constraints nullable="false"/>
      </column>
      <column name="audience_id" type="UUID">
        <constraints nullable="false"/>
      </column>
    </createTable>
  </changeSet>
  <changeSet id="1771595367473-3" author="mmoya@PragmaInvest.com">
    <addUniqueConstraint columnNames="name" constraintName="uc_audiences_name"
      tableName="audiences"/>
  </changeSet>
  <changeSet id="1771595367473-4" author="mmoya@PragmaInvest.com">
    <addForeignKeyConstraint baseColumnNames="audience_id" baseTableName="client_audiences"
      constraintName="FK_CLIENT_AUDIENCES_ON_AUDIENCE" referencedColumnNames="id"
      referencedTableName="audiences"/>
  </changeSet>
  <changeSet id="1771595367473-5" author="mmoya@PragmaInvest.com">
    <addForeignKeyConstraint baseColumnNames="client_id" baseTableName="client_audiences"
      constraintName="FK_CLIENT_AUDIENCES_ON_CLIENT" referencedColumnNames="id"
      referencedTableName="clients"/>
  </changeSet>

</databaseChangeLog>