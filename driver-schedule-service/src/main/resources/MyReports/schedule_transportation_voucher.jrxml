	<import value="com.kernotec.driverscheduleservice.util.VoucherJasperUtil"/>
	<parameter name="SCHEDULE_TRANSPORTATION_ID" class="java.lang.String">
		<defaultValueExpression><![CDATA["f19dfc57-daed-4aaf-9d30-4babd6454790"]]></defaultValueExpression>
	</parameter>
	<parameter name="MAIN_TITLE" class="java.lang.String">
		<defaultValueExpression><![CDATA["Comprobante de Salida"]]></defaultValueExpression>
	</parameter>
	<parameter name="ZONE_ID" class="java.lang.String">
		<defaultValueExpression><![CDATA["America/La_Paz"]]></defaultValueExpression>
	</parameter>
	<parameter name="TITLE_LOGO_IMG" class="java.lang.Object"/>
	<parameter name="CLOCK_ICON_IMG" class="java.lang.Object"/>
	<parameter name="USERS_ICON_IMG" class="java.lang.Object"/>
	<parameter name="BOX_ICON_IMG" class="java.lang.Object"/>
	<parameter name="PHONE_ICON_IMG" class="java.lang.Object"/>
	<queryString>
		<![CDATA[SELECT st.created_at,
st.schedule_from,
st.schedule_to,
sts.code as schedule_state_code,
tr.code  as request_unique_code,
preq."name" as person_requested_name,
preq.last_name as person_requested_last_name,
tr.trip_type,
tr.is_short_notice,
tr.people_number,
tr.is_asset_pickup,
tr.passengers,
tr.assets,
tr.detail,
coalesce((select json_agg(json_build_object('id', c.id, 'value', c.value, 'label', lt.code ))::TEXT
from contacts c
left join label_types lt on lt.id = c.label_type_id 
inner join contact_categories cc on cc.id = c.contact_category_id
where c.person_id = preq.id and cc.code = 'PHONE'
) ,'[]') as preq_phone_list,
count(DISTINCT cr.id) as cancel_reasons_count,
count(DISTINCT rr.id) as reschedule_reasons_count
FROM schedule_transportations st
inner join schedule_transportation_states sts on sts.id = st.schedule_transportation_state_id
inner join transportation_requests tr on tr.id = st.transportation_request_id 
inner join person preq on preq.id = st.person_requested_id  
left join cancel_reasons cr on cr.schedule_transportation_id = st.id
left join reschedule_reasons rr on rr.schedule_transportation_id = st.id
WHERE st.id = $P{SCHEDULE_TRANSPORTATION_ID}::uuid
group by st.id,
st.created_at,
sts.code,
tr.code,
tr.trip_type,
tr.is_short_notice,
tr.people_number,
tr.is_asset_pickup,
tr.passengers,
tr.assets,
tr.detail,
preq.id,
preq."name",
preq.last_name;]]>
	</queryString>
