	<queryString language="SQL">
		<![CDATA[SELECT st.created_at,st.created_by_user, v.vehicle_number,
 vt.name as vehicle_type, driver.name as driver_name,
 driver.last_name as driver_last_name
FROM schedule_transportations st
JOIN vehicles v ON v.id = st.vehicle_id
JOIN vehicle_types vt ON vt.id = v.vehicle_type_id
JOIN person driver ON driver.id = st.driver_id
WHERE st.id = '902e2f7c-dc42-4f2f-b71f-f1d62dcdfca8']]>
	</queryString>
