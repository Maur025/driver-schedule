	<parameter name="SCHEDULE_TRANSPORTATION_ID" class="java.lang.String">
		<defaultValueExpression><![CDATA["f19dfc57-daed-4aaf-9d30-4babd6454790"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select p.name as driver_name,
p.last_name as driver_last_name,
v.model as vehicle_model,
v.vehicle_number,
coalesce((
select json_agg(json_build_object('id',c.id, 'value', c.value, 'label', lt.code ))::TEXT
from contacts c
inner join label_types lt on lt.id = c.label_type_id
left join contact_categories cc on cc.id = c.contact_category_id
where c.person_id = p.id and cc.code = 'PHONE'
),'[]') as driver_phone_lisT
from trip_assignments ta
inner join person p on p.id = ta.driver_id
inner join vehicles v on v.id = ta.vehicle_id 
where ta.schedule_transportation_id =  $P{SCHEDULE_TRANSPORTATION_ID}::uuid;]]>
	</queryString>
