					</reportElement>
					<textElement textAlignment="Right">
						<font fontName="OpenSans" size="7"/>
					</textElement>
					<textFieldExpression><![CDATA["Página " +$V{PAGE_NUMBER}+ " de " +$V{MASTER_TOTAL_PAGES}]]></textFieldExpression>
				</textField>
			</frame>
		</band>
	</pageFooter>
</jasperReport>
