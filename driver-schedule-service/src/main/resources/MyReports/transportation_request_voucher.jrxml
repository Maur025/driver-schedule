	<parameter name="TRANSPORTATION_REQUEST_ID" class="java.lang.String">
		<defaultValueExpression><![CDATA["90236f15-6d52-4d24-9258-8a06f3322519"]]></defaultValueExpression>
	</parameter>
	<parameter name="MAIN_TITLE" class="java.lang.String">
		<defaultValueExpression><![CDATA["Comprobante de Solicitud"]]></defaultValueExpression>
	</parameter>
	<parameter name="ZONE_ID" class="java.lang.String">
		<defaultValueExpression><![CDATA["America/La_Paz"]]></defaultValueExpression>
	</parameter>
	<parameter name="TITLE_LOGO_IMG" class="java.lang.Object"/>
	<parameter name="CLOCK_ICON_IMG" class="java.lang.Object"/>
	<parameter name="USERS_ICON_IMG" class="java.lang.Object"/>
	<parameter name="BOX_ICON_IMG" class="java.lang.Object"/>
	<parameter name="PHONE_ICON_IMG" class="java.lang.Object"/>
	<queryString>
		<![CDATA[SELECT tr.created_at,
tr.created_by_user,
tr.people_number,
tr.assets,
tr.passengers,
tr.start_time,
tr.end_time,
tr.trip_type,
tr.is_short_notice,
tr.requested_date,
tr.correlative,
tr.detail, 
tr.is_asset_pickup,
tr.code as request_code,
tr.was_requested_by_scheduler,
trs.code as request_status,
preq.name as person_req_name,
preq.last_name as person_req_lastname,
COUNT(DISTINCT rr.id) as reject_reasons_count,
COUNT(DISTINCT crr.id) as cancel_request_reasons_count,
COALESCE ((SELECT json_agg(json_build_object('id',c.id ,'value', c.value, 'label',lt.code))::TEXT
	FROM contacts c 
	LEFT JOIN label_types lt ON lt.id = c.label_type_id 
	INNER JOIN contact_categories cc ON cc.id = c.contact_category_id 
	WHERE c.person_id = preq.id and cc.code = 'PHONE' 
), '[]') as contacts_list,
coalesce((select json_agg(json_build_object('reasonLabel',r_rej.value, 'reasonCode',r_rej.code, 'otherReason', rej_r.other_reason ))::TEXT
	from reject_reasons rej_r
	inner join reasons r_rej on r_rej.id = rej_r.reason_id 
	where rej_r.transportation_request_id = tr.id
),'[]') as reject_reason_list,
coalesce((select json_agg(json_build_object('reasonLabel',r_canr.value, 'reasonCode',r_canr.code, 'otherReason',canr_r.other_reason ))::TEXT
	from cancel_request_reasons canr_r
	inner join reasons r_canr on r_canr.id = canr_r.reason_id 
	where canr_r.transportation_request_id = tr.id 
),'[]') as cancel_request_reason_list
FROM transportation_requests tr
INNER JOIN transportation_request_states trs ON trs.id = tr.transportation_request_state_id
INNER JOIN person preq ON preq.id = tr.person_requested_id
LEFT JOIN reject_reasons rr ON rr.transportation_request_id = tr.id
LEFT JOIN cancel_request_reasons crr ON crr.transportation_request_id = tr.id
WHERE tr.id = $P{TRANSPORTATION_REQUEST_ID}::uuid
GROUP BY tr.id,
trs.code,
preq.id,
preq.name,
preq.last_name;]]>
	</queryString>
