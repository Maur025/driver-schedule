<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="transportation_request_voucher" pageWidth="612" pageHeight="792" columnWidth="500" leftMargin="70" rightMargin="42" topMargin="42" bottomMargin="28" uuid="1776627e-4d24-4a70-9b44-f8fb8b3d1e38">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="driver-schedule-service"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w1" value="489"/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w2" value="500"/>
