	<parameter name="TRANSPORTATION_REQUEST_ID" class="java.lang.String">
		<defaultValueExpression><![CDATA["2cad4136-633c-4c8b-bfa4-2534d4c2dc8f"]]></defaultValueExpression>
	</parameter>
	<parameter name="MAIN_TITLE" class="java.lang.String">
		<defaultValueExpression><![CDATA["Comprobante de Solicitud"]]></defaultValueExpression>
	</parameter>
	<parameter name="ZONE_ID" class="java.lang.String">
		<defaultValueExpression><![CDATA["America/La_Paz"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT tr.created_at,
tr.created_by_user,
tr.people_number,
tr.assets,
tr.passengers,
tr.start_time,
tr.end_time,
tr.trip_type,
tr.is_short_notice,
tr.requested_date,
tr.correlative,
tr.detail, 
tr.is_asset_pickup,
tr.code as request_code,
tr.was_requested_by_scheduler,
trs.code as request_status,
preq.name as person_req_name,
preq.last_name as person_req_lastname,
COUNT(DISTINCT rrr.id) as reject_reasons_count,
COUNT(DISTINCT crrr.id) as cancel_request_reasons_count,
COALESCE ((SELECT json_agg(json_build_object('id',c.id ,'value', c.value, 'label',lt.code))::TEXT
FROM contacts c 
LEFT JOIN label_types lt ON lt.id = c.label_type_id 
INNER JOIN contact_categories cc ON cc.id = c.contact_category_id 
WHERE c.person_id = preq.id and cc.code = 'PHONE' 
), '[]') as contacts_list
FROM transportation_requests tr
INNER JOIN transportation_request_states trs ON trs.id = tr.transportation_request_state_id
INNER JOIN person preq ON preq.id = tr.person_requested_id
LEFT JOIN reject_reasons rr ON rr.transportation_request_id = tr.id
LEFT JOIN reasons rrr ON rrr.id = rr.reason_id
LEFT JOIN cancel_request_reasons crr ON crr.transportation_request_id = tr.id
LEFT JOIN reasons crrr ON crrr.id = crr.reason_id
WHERE tr.id = $P{TRANSPORTATION_REQUEST_ID}::uuid
GROUP BY tr.id,
trs.code,
preq.id,
preq.name,
preq.last_name;]]>
	</queryString>
