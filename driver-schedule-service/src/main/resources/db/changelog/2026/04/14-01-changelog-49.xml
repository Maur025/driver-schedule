<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd"
  objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
  <changeSet id="1776185325999-1" author="mmoya@PragmaInvest.com">
    <createTable tableName="emergency_response_types">
      <column defaultValueComputed="uuid_generate_v4()" name="id" type="uuid">
        <constraints nullable="false" primaryKey="true"
          primaryKeyName="pk_emergency_response_types"/>
      </column>
      <column defaultValueComputed="now()" name="created_at" type="timestamp">
        <constraints nullable="false"/>
      </column>
      <column name="created_by" type="VARCHAR(255)"/>
      <column defaultValueComputed="now()" name="updated_at" type="timestamp">
        <constraints nullable="false"/>
      </column>
      <column name="updated_by" type="VARCHAR(255)"/>
      <column defaultValueNumeric="0" name="version" type="bigint">
        <constraints nullable="false"/>
      </column>
      <column defaultValueBoolean="false" name="deleted" type="boolean">
        <constraints nullable="false"/>
      </column>
      <column name="name" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="code" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
    </createTable>
  </changeSet>
  <changeSet id="1776185325999-2" author="mmoya@PragmaInvest.com">
    <createTable tableName="emergency_responses">
      <column defaultValueComputed="uuid_generate_v4()" name="id" type="uuid">
        <constraints nullable="false" primaryKey="true" primaryKeyName="pk_emergency_responses"/>
      </column>
      <column name="created_by_user" type="jsonb"/>
      <column name="updated_by_user" type="jsonb"/>
      <column defaultValueComputed="now()" name="created_at" type="timestamp">
        <constraints nullable="false"/>
      </column>
      <column name="created_by" type="VARCHAR(255)"/>
      <column defaultValueComputed="now()" name="updated_at" type="timestamp">
        <constraints nullable="false"/>
      </column>
      <column name="updated_by" type="VARCHAR(255)"/>
      <column defaultValueNumeric="0" name="version" type="bigint">
        <constraints nullable="false"/>
      </column>
      <column defaultValueBoolean="false" name="deleted" type="boolean">
        <constraints nullable="false"/>
      </column>
      <column name="other_response_detail" type="VARCHAR(1024)"/>
      <column name="detail" type="VARCHAR(1024)"/>
      <column name="trip_emergency_id" type="UUID">
        <constraints nullable="false"/>
      </column>
      <column name="emergency_response_type_id" type="UUID">
        <constraints nullable="false"/>
      </column>
    </createTable>
  </changeSet>
  <changeSet id="1776185325999-3" author="mmoya@PragmaInvest.com">
    <createTable tableName="observation_types">
      <column defaultValueComputed="uuid_generate_v4()" name="id" type="uuid">
        <constraints nullable="false" primaryKey="true" primaryKeyName="pk_observation_types"/>
      </column>
      <column defaultValueComputed="now()" name="created_at" type="timestamp">
        <constraints nullable="false"/>
      </column>
      <column name="created_by" type="VARCHAR(255)"/>
      <column defaultValueComputed="now()" name="updated_at" type="timestamp">
        <constraints nullable="false"/>
      </column>
      <column name="updated_by" type="VARCHAR(255)"/>
      <column defaultValueNumeric="0" name="version" type="bigint">
        <constraints nullable="false"/>
      </column>
      <column defaultValueBoolean="false" name="deleted" type="boolean">
        <constraints nullable="false"/>
      </column>
      <column name="name" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="code" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
    </createTable>
  </changeSet>
  <changeSet id="1776185325999-4" author="mmoya@PragmaInvest.com">
    <createTable tableName="obsevations">
      <column defaultValueComputed="uuid_generate_v4()" name="id" type="uuid">
        <constraints nullable="false" primaryKey="true" primaryKeyName="pk_obsevations"/>
      </column>
      <column defaultValueComputed="now()" name="created_at" type="timestamp">
        <constraints nullable="false"/>
      </column>
      <column name="created_by" type="VARCHAR(255)"/>
      <column defaultValueComputed="now()" name="updated_at" type="timestamp">
        <constraints nullable="false"/>
      </column>
      <column name="updated_by" type="VARCHAR(255)"/>
      <column defaultValueNumeric="0" name="version" type="bigint">
        <constraints nullable="false"/>
      </column>
      <column defaultValueBoolean="false" name="deleted" type="boolean">
        <constraints nullable="false"/>
      </column>
      <column name="name" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="code" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="observation_type_id" type="UUID">
        <constraints nullable="false"/>
      </column>
    </createTable>
  </changeSet>
  <changeSet id="1776185325999-5" author="mmoya@PragmaInvest.com">
    <addUniqueConstraint columnNames="code, observation_type_id"
      constraintName="UC_observation_code_type" tableName="obsevations"/>
  </changeSet>
  <changeSet id="1776185325999-6" author="mmoya@PragmaInvest.com">
    <addUniqueConstraint columnNames="code" constraintName="uc_emergency_response_types_code"
      tableName="emergency_response_types"/>
  </changeSet>
  <changeSet id="1776185325999-7" author="mmoya@PragmaInvest.com">
    <addForeignKeyConstraint baseColumnNames="emergency_response_type_id"
      baseTableName="emergency_responses"
      constraintName="FK_EMERGENCY_RESPONSES_ON_EMERGENCY_RESPONSE_TYPE" referencedColumnNames="id"
      referencedTableName="emergency_response_types"/>
  </changeSet>
  <changeSet id="1776185325999-8" author="mmoya@PragmaInvest.com">
    <addForeignKeyConstraint baseColumnNames="trip_emergency_id" baseTableName="emergency_responses"
      constraintName="FK_EMERGENCY_RESPONSES_ON_TRIP_EMERGENCY" referencedColumnNames="id"
      referencedTableName="trip_emergencies"/>
  </changeSet>
  <changeSet id="1776185325999-9" author="mmoya@PragmaInvest.com">
    <addForeignKeyConstraint baseColumnNames="observation_type_id" baseTableName="obsevations"
      constraintName="FK_OBSEVATIONS_ON_OBSERVATION_TYPE" referencedColumnNames="id"
      referencedTableName="observation_types"/>
  </changeSet>

</databaseChangeLog>