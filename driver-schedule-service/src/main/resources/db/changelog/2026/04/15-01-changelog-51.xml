<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd"
  objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
  <changeSet id="1776263839656-5" author="mmoya@PragmaInvest.com">
    <dropForeignKeyConstraint baseTableName="obsevations"
      constraintName="fk_obsevations_on_observation_type"/>

    <dropUniqueConstraint constraintName="uc_observation_code_type" tableName="obsevations"/>
  </changeSet>
  <changeSet id="1776263839656-6" author="mmoya@PragmaInvest.com">
    <dropForeignKeyConstraint baseTableName="trip_observations"
      constraintName="fk_trip_observations_on_observation"/>
  </changeSet>
  <changeSet id="1776263839656-1" author="mmoya@PragmaInvest.com">
    <createTable tableName="observations">
      <column defaultValueComputed="uuid_generate_v4()" name="id" type="uuid">
        <constraints nullable="false" primaryKey="true" primaryKeyName="pk_observations"/>
      </column>
      <column defaultValueComputed="now()" name="created_at" type="timestamp">
        <constraints nullable="false"/>
      </column>
      <column name="created_by" type="VARCHAR(255)"/>
      <column defaultValueComputed="now()" name="updated_at" type="timestamp">
        <constraints nullable="false"/>
      </column>
      <column name="updated_by" type="VARCHAR(255)"/>
      <column defaultValueNumeric="0" name="version" type="bigint">
        <constraints nullable="false"/>
      </column>
      <column defaultValueBoolean="false" name="deleted" type="boolean">
        <constraints nullable="false"/>
      </column>
      <column name="name" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="code" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="observation_type_id" type="UUID">
        <constraints nullable="false"/>
      </column>
    </createTable>
  </changeSet>
  <changeSet id="1776263839656-2" author="mmoya@PragmaInvest.com">
    <addUniqueConstraint columnNames="code, observation_type_id"
      constraintName="UC_observation_code_type" tableName="observations"/>
  </changeSet>
  <changeSet id="1776263839656-3" author="mmoya@PragmaInvest.com">
    <addForeignKeyConstraint baseColumnNames="observation_type_id" baseTableName="observations"
      constraintName="FK_OBSERVATIONS_ON_OBSERVATION_TYPE" referencedColumnNames="id"
      referencedTableName="observation_types"/>
  </changeSet>
  <changeSet id="1776263839656-4" author="mmoya@PragmaInvest.com">
    <addForeignKeyConstraint baseColumnNames="observation_id" baseTableName="trip_observations"
      constraintName="FK_TRIP_OBSERVATIONS_ON_OBSERVATION" referencedColumnNames="id"
      referencedTableName="observations"/>
  </changeSet>
  <changeSet id="1776263839656-8" author="mmoya@PragmaInvest.com">
    <dropTable cascadeConstraints="true" tableName="obsevations"/>
  </changeSet>

</databaseChangeLog>