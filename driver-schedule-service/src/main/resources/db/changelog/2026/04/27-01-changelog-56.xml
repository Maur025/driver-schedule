<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd"
  objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
  <changeSet id="1777330222257-17" author="mmoya@PragmaInvest.com">
    <dropForeignKeyConstraint baseTableName="notification_logs"
      constraintName="fk_notification_logs_on_notification_configuration"/>
  </changeSet>
  <changeSet id="1777330222257-3" author="mmoya@PragmaInvest.com">
    <addColumn tableName="notification_logs">
      <column name="device_id" type="VARCHAR(255)"/>
      <column name="person_id" type="UUID"/>
      <column name="platform" type="VARCHAR(255)"/>
      <column name="sent_at" type="DATETIME"/>
      <column name="token" type="TEXT"/>
      <column name="user_id" type="UUID"/>
    </addColumn>
  </changeSet>
  <changeSet id="1777330222257-4" author="mmoya@PragmaInvest.com">
    <addNotNullConstraint columnName="device_id" tableName="notification_logs"/>
  </changeSet>
  <changeSet id="1777330222257-6" author="mmoya@PragmaInvest.com">
    <addNotNullConstraint columnName="person_id" tableName="notification_logs"/>
  </changeSet>
  <changeSet id="1777330222257-8" author="mmoya@PragmaInvest.com">
    <addNotNullConstraint columnName="platform" tableName="notification_logs"/>
  </changeSet>
  <changeSet id="1777330222257-10" author="mmoya@PragmaInvest.com">
    <addNotNullConstraint columnName="sent_at" tableName="notification_logs"/>
  </changeSet>
  <changeSet id="1777330222257-12" author="mmoya@PragmaInvest.com">
    <addNotNullConstraint columnName="token" tableName="notification_logs"/>
  </changeSet>
  <changeSet id="1777330222257-14" author="mmoya@PragmaInvest.com">
    <addNotNullConstraint columnName="user_id" tableName="notification_logs"/>
  </changeSet>
  <changeSet id="1777330222257-15" author="mmoya@PragmaInvest.com">
    <addUniqueConstraint columnNames="device_id" constraintName="uc_notification_logs_device"
      tableName="notification_logs"/>
  </changeSet>
  <changeSet id="1777330222257-16" author="mmoya@PragmaInvest.com">
    <addForeignKeyConstraint baseColumnNames="person_id" baseTableName="notification_logs"
      constraintName="FK_NOTIFICATION_LOGS_ON_PERSON" referencedColumnNames="id"
      referencedTableName="person"/>
  </changeSet>
  <changeSet id="1777330222257-18" author="mmoya@PragmaInvest.com">
    <dropColumn columnName="notification_configuration_id" tableName="notification_logs"/>

    <dropColumn columnName="notification_log_state" tableName="notification_logs"/>
  </changeSet>
  <changeSet id="1777330222257-2" author="mmoya@PragmaInvest.com">
    <addColumn tableName="notification_logs">
      <column name="notification_log_state" type="VARCHAR(255)">
        <constraints nullable="false" validateNullable="true"/>
      </column>
    </addColumn>
  </changeSet>

</databaseChangeLog>