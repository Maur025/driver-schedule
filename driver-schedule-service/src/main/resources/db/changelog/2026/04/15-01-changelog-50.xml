<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd"
  objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
  <changeSet id="1776262317316-1" author="mmoya@PragmaInvest.com">
    <createTable tableName="trip_observations">
      <column defaultValueComputed="uuid_generate_v4()" name="id" type="uuid">
        <constraints nullable="false" primaryKey="true" primaryKeyName="pk_trip_observations"/>
      </column>
      <column name="created_by_user" type="jsonb"/>
      <column name="updated_by_user" type="jsonb"/>
      <column defaultValueComputed="now()" name="created_at" type="timestamp">
        <constraints nullable="false"/>
      </column>
      <column name="created_by" type="VARCHAR(255)"/>
      <column defaultValueComputed="now()" name="updated_at" type="timestamp">
        <constraints nullable="false"/>
      </column>
      <column name="updated_by" type="VARCHAR(255)"/>
      <column defaultValueNumeric="0" name="version" type="bigint">
        <constraints nullable="false"/>
      </column>
      <column defaultValueBoolean="false" name="deleted" type="boolean">
        <constraints nullable="false"/>
      </column>
      <column name="other_observation" type="VARCHAR(255)"/>
      <column name="trip_id" type="UUID">
        <constraints nullable="false"/>
      </column>
      <column name="observation_id" type="UUID">
        <constraints nullable="false"/>
      </column>
    </createTable>
  </changeSet>
  <changeSet id="1776262317316-2" author="mmoya@PragmaInvest.com">
    <addForeignKeyConstraint baseColumnNames="observation_id" baseTableName="trip_observations"
      constraintName="FK_TRIP_OBSERVATIONS_ON_OBSERVATION" referencedColumnNames="id"
      referencedTableName="obsevations"/>
  </changeSet>
  <changeSet id="1776262317316-3" author="mmoya@PragmaInvest.com">
    <addForeignKeyConstraint baseColumnNames="trip_id" baseTableName="trip_observations"
      constraintName="FK_TRIP_OBSERVATIONS_ON_TRIP" referencedColumnNames="id"
      referencedTableName="trips"/>
  </changeSet>
  <changeSet id="1776262317316-4" author="mmoya@PragmaInvest.com">
    <dropColumn columnName="other_response_detail" tableName="emergency_responses"/>
  </changeSet>

</databaseChangeLog>