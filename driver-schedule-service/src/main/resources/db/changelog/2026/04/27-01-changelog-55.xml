<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd"
  objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
  <changeSet id="1777318365525-1" author="mmoya@PragmaInvest.com">
    <createTable tableName="notification_campaigns">
      <column defaultValueComputed="uuid_generate_v4()" name="id" type="uuid">
        <constraints nullable="false" primaryKey="true" primaryKeyName="pk_notification_campaigns"/>
      </column>
      <column name="created_by_user" type="jsonb"/>
      <column name="updated_by_user" type="jsonb"/>
      <column defaultValueComputed="now()" name="created_at" type="timestamp">
        <constraints nullable="false"/>
      </column>
      <column name="created_by" type="VARCHAR(255)"/>
      <column defaultValueComputed="now()" name="updated_at" type="timestamp">
        <constraints nullable="false"/>
      </column>
      <column name="updated_by" type="VARCHAR(255)"/>
      <column defaultValueNumeric="0" name="version" type="bigint">
        <constraints nullable="false"/>
      </column>
      <column defaultValueBoolean="false" name="deleted" type="boolean">
        <constraints nullable="false"/>
      </column>
      <column name="title" type="VARCHAR(512)">
        <constraints nullable="false"/>
      </column>
      <column name="body" type="VARCHAR(2048)">
        <constraints nullable="false"/>
      </column>
      <column name="campaign_recipient" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="person_ids" type="TEXT">
        <constraints nullable="false"/>
      </column>
    </createTable>
  </changeSet>
  <changeSet id="1777318365525-2" author="mmoya@PragmaInvest.com">
    <createTable tableName="notification_configurations">
      <column defaultValueComputed="uuid_generate_v4()" name="id" type="uuid">
        <constraints nullable="false" primaryKey="true"
          primaryKeyName="pk_notification_configurations"/>
      </column>
      <column name="created_by_user" type="jsonb"/>
      <column name="updated_by_user" type="jsonb"/>
      <column defaultValueComputed="now()" name="created_at" type="timestamp">
        <constraints nullable="false"/>
      </column>
      <column name="created_by" type="VARCHAR(255)"/>
      <column defaultValueComputed="now()" name="updated_at" type="timestamp">
        <constraints nullable="false"/>
      </column>
      <column name="updated_by" type="VARCHAR(255)"/>
      <column defaultValueNumeric="0" name="version" type="bigint">
        <constraints nullable="false"/>
      </column>
      <column defaultValueBoolean="false" name="deleted" type="boolean">
        <constraints nullable="false"/>
      </column>
      <column name="user_id" type="UUID">
        <constraints nullable="false"/>
      </column>
      <column name="device_id" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="platform" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="token" type="TEXT">
        <constraints nullable="false"/>
      </column>
      <column name="actived" type="BOOLEAN">
        <constraints nullable="false"/>
      </column>
      <column name="person_id" type="UUID">
        <constraints nullable="false"/>
      </column>
    </createTable>
  </changeSet>
  <changeSet id="1777318365525-3" author="mmoya@PragmaInvest.com">
    <createTable tableName="notification_logs">
      <column defaultValueComputed="uuid_generate_v4()" name="id" type="uuid">
        <constraints nullable="false" primaryKey="true" primaryKeyName="pk_notification_logs"/>
      </column>
      <column name="created_by_user" type="jsonb"/>
      <column name="updated_by_user" type="jsonb"/>
      <column defaultValueComputed="now()" name="created_at" type="timestamp">
        <constraints nullable="false"/>
      </column>
      <column name="created_by" type="VARCHAR(255)"/>
      <column defaultValueComputed="now()" name="updated_at" type="timestamp">
        <constraints nullable="false"/>
      </column>
      <column name="updated_by" type="VARCHAR(255)"/>
      <column defaultValueNumeric="0" name="version" type="bigint">
        <constraints nullable="false"/>
      </column>
      <column defaultValueBoolean="false" name="deleted" type="boolean">
        <constraints nullable="false"/>
      </column>
      <column name="notification_log_state" type="SMALLINT">
        <constraints nullable="false"/>
      </column>
      <column name="notification_configuration_id" type="UUID">
        <constraints nullable="false"/>
      </column>
      <column name="notification_campaign_id" type="UUID">
        <constraints nullable="false"/>
      </column>
    </createTable>
  </changeSet>
  <changeSet id="1777318365525-4" author="mmoya@PragmaInvest.com">
    <addUniqueConstraint columnNames="device_id"
      constraintName="uc_notification_configurations_device"
      tableName="notification_configurations"/>
  </changeSet>
  <changeSet id="1777318365525-5" author="mmoya@PragmaInvest.com">
    <addForeignKeyConstraint baseColumnNames="person_id" baseTableName="notification_configurations"
      constraintName="FK_NOTIFICATION_CONFIGURATIONS_ON_PERSON" referencedColumnNames="id"
      referencedTableName="person"/>
  </changeSet>
  <changeSet id="1777318365525-6" author="mmoya@PragmaInvest.com">
    <addForeignKeyConstraint baseColumnNames="notification_campaign_id"
      baseTableName="notification_logs"
      constraintName="FK_NOTIFICATION_LOGS_ON_NOTIFICATION_CAMPAIGN" referencedColumnNames="id"
      referencedTableName="notification_campaigns"/>
  </changeSet>
  <changeSet id="1777318365525-7" author="mmoya@PragmaInvest.com">
    <addForeignKeyConstraint baseColumnNames="notification_configuration_id"
      baseTableName="notification_logs"
      constraintName="FK_NOTIFICATION_LOGS_ON_NOTIFICATION_CONFIGURATION" referencedColumnNames="id"
      referencedTableName="notification_configurations"/>
  </changeSet>

</databaseChangeLog>