<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd"
  objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
  <changeSet id="1769100218841-1" author="mmoya@PragmaInvest.com">
    <addColumn tableName="contacts">
      <column name="person_id" type="UUID"/>
    </addColumn>
  </changeSet>
  <changeSet id="1769100218841-2" author="mmoya@PragmaInvest.com">
    <addNotNullConstraint columnName="person_id" tableName="contacts"/>
  </changeSet>
  <changeSet id="1769100218841-3" author="mmoya@PragmaInvest.com">
    <addForeignKeyConstraint baseColumnNames="person_id" baseTableName="contacts"
      constraintName="FK_CONTACTS_ON_PERSON" referencedColumnNames="id"
      referencedTableName="person"/>
  </changeSet>

</databaseChangeLog>