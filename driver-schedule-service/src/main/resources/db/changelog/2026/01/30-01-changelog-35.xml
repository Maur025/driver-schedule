<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd"
  objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
  <changeSet id="1769790007239-1" author="mmoya@PragmaInvest.com">
    <addNotNullConstraint columnDataType="VARCHAR(255)" columnName="code" tableName="reasons"
      validate="true"/>
  </changeSet>
  <changeSet id="1769790007239-2" author="mmoya@PragmaInvest.com">
    <addNotNullConstraint columnDataType="UUID" columnName="reason_type_id" tableName="reasons"
      validate="true"/>
  </changeSet>
  <changeSet id="1769790007239-3" author="mmoya@PragmaInvest.com">
    <addNotNullConstraint columnDataType="VARCHAR(255)" columnName="value" tableName="reasons"
      validate="true"/>
  </changeSet>

</databaseChangeLog>