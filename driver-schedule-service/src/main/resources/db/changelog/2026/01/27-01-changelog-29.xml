<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd"
  objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
  <changeSet id="1769541966627-1" author="mmoya@PragmaInvest.com">
    <createTable tableName="label_types">
      <column defaultValueComputed="uuid_generate_v4()" name="id" type="uuid">
        <constraints nullable="false" primaryKey="true" primaryKeyName="pk_label_types"/>
      </column>
      <column defaultValueComputed="now()" name="created_at" type="timestamp">
        <constraints nullable="false"/>
      </column>
      <column name="created_by" type="VARCHAR(255)"/>
      <column defaultValueComputed="now()" name="updated_at" type="timestamp">
        <constraints nullable="false"/>
      </column>
      <column name="updated_by" type="VARCHAR(255)"/>
      <column defaultValueNumeric="0" name="version" type="bigint">
        <constraints nullable="false"/>
      </column>
      <column defaultValueBoolean="false" name="deleted" type="boolean">
        <constraints nullable="false"/>
      </column>
      <column name="name" type="VARCHAR(50)">
        <constraints nullable="false"/>
      </column>
      <column name="code" type="VARCHAR(50)">
        <constraints nullable="false"/>
      </column>
      <column name="contact_category_id" type="UUID">
        <constraints nullable="false"/>
      </column>
    </createTable>
  </changeSet>
  <changeSet id="1769541966627-2" author="mmoya@PragmaInvest.com">
    <addColumn tableName="contacts">
      <column name="label_type_id" type="UUID"/>
    </addColumn>
  </changeSet>
  <changeSet id="1769541966627-3" author="mmoya@PragmaInvest.com">
    <addForeignKeyConstraint baseColumnNames="label_type_id" baseTableName="contacts"
      constraintName="FK_CONTACTS_ON_LABEL_TYPE" referencedColumnNames="id"
      referencedTableName="label_types"/>
  </changeSet>
  <changeSet id="1769541966627-4" author="mmoya@PragmaInvest.com">
    <addForeignKeyConstraint baseColumnNames="contact_category_id" baseTableName="label_types"
      constraintName="FK_LABEL_TYPES_ON_CONTACT_CATEGORY" referencedColumnNames="id"
      referencedTableName="contact_categories"/>
  </changeSet>

</databaseChangeLog>