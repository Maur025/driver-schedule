<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd"
  objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
  <changeSet id="1769711467623-1" author="mmoya@PragmaInvest.com">
    <addColumn tableName="reasons">
      <column name="code" type="VARCHAR(255)"/>
    </addColumn>
  </changeSet>
  <changeSet id="1769711467623-2" author="mmoya@PragmaInvest.com">
    <addColumn tableName="trip_assignments">
      <column name="schedule_transportation_id" type="UUID"/>
    </addColumn>
  </changeSet>
  <changeSet id="1769711467623-3" author="mmoya@PragmaInvest.com">
    <addNotNullConstraint columnName="schedule_transportation_id" tableName="trip_assignments"/>
  </changeSet>
  <changeSet id="1769711467623-4" author="mmoya@PragmaInvest.com">
    <addColumn tableName="request_coords">
      <column name="sleep_time_minutes" type="DOUBLE"/>
    </addColumn>
  </changeSet>
  <changeSet id="1769711467623-5" author="mmoya@PragmaInvest.com">
    <addForeignKeyConstraint baseColumnNames="schedule_transportation_id"
      baseTableName="trip_assignments"
      constraintName="FK_TRIP_ASSIGNMENTS_ON_SCHEDULE_TRANSPORTATION" referencedColumnNames="id"
      referencedTableName="schedule_transportations"/>
  </changeSet>

</databaseChangeLog>