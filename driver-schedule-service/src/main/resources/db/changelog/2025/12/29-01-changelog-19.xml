<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd"
  objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
  <changeSet id="1767041588443-1" author="mmoya@PragmaInvest.com">
    <createTable tableName="request_locations">
      <column defaultValueComputed="uuid_generate_v4()" name="id" type="uuid">
        <constraints nullable="false" primaryKey="true" primaryKeyName="pk_request_locations"/>
      </column>
      <column defaultValueComputed="now()" name="created_at" type="timestamp">
        <constraints nullable="false"/>
      </column>
      <column name="created_by" type="VARCHAR(255)"/>
      <column defaultValueComputed="now()" name="updated_at" type="timestamp">
        <constraints nullable="false"/>
      </column>
      <column name="updated_by" type="VARCHAR(255)"/>
      <column defaultValueNumeric="0" name="version" type="bigint">
        <constraints nullable="false"/>
      </column>
      <column defaultValueBoolean="false" name="deleted" type="boolean">
        <constraints nullable="false"/>
      </column>
      <column name="location_id" type="UUID">
        <constraints nullable="false"/>
      </column>
      <column name="transportation_request_id" type="UUID">
        <constraints nullable="false"/>
      </column>
      <column name="location_type" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
    </createTable>
  </changeSet>
  <changeSet id="1767041588443-2" author="mmoya@PragmaInvest.com">
    <addForeignKeyConstraint baseColumnNames="location_id" baseTableName="request_locations"
      constraintName="FK_REQUEST_LOCATIONS_ON_LOCATION" referencedColumnNames="id"
      referencedTableName="locations"/>
  </changeSet>
  <changeSet id="1767041588443-3" author="mmoya@PragmaInvest.com">
    <addForeignKeyConstraint baseColumnNames="transportation_request_id"
      baseTableName="request_locations"
      constraintName="FK_REQUEST_LOCATIONS_ON_TRANSPORTATION_REQUEST" referencedColumnNames="id"
      referencedTableName="transportation_requests"/>
  </changeSet>

</databaseChangeLog>