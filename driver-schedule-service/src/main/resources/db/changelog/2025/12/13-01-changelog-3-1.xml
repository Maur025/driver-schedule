      <column defaultValueComputed="now()" name="created_at" type="timestamp">
        <constraints nullable="false"/>
      </column>
      <column name="created_by" type="VARCHAR(255)"/>
      <column defaultValueComputed="now()" name="updated_at" type="timestamp">
        <constraints nullable="false"/>
      </column>
      <column name="updated_by" type="VARCHAR(255)"/>
      <column defaultValueNumeric="0" name="version" type="bigint">
        <constraints nullable="false"/>
      </column>
      <column defaultValueBoolean="false" name="deleted" type="boolean">
        <constraints nullable="false"/>
      </column>
      <column name="reason_id" type="UUID">
        <constraints nullable="false"/>
      </column>
      <column name="schedule_transportation_id" type="UUID">
        <constraints nullable="false"/>
      </column>
    </createTable>
  </changeSet>
  <changeSet id="1765645557670-5" author="mauro">
    <addColumn tableName="transportation_requests">
      <column name="trip_type" type="VARCHAR(255)"/>
    </addColumn>
  </changeSet>
  <changeSet id="1765645557670-6" author="mauro">
    <addNotNullConstraint columnName="trip_type" tableName="transportation_requests"/>
  </changeSet>
  <changeSet id="1765645557670-7" author="mauro">
    <addForeignKeyConstraint baseColumnNames="reason_id" baseTableName="cancel_reasons"
      constraintName="FK_CANCEL_REASONS_ON_REASON" referencedColumnNames="id"
      referencedTableName="reasons"/>
  </changeSet>
  <changeSet id="1765645557670-8" author="mauro">
    <addForeignKeyConstraint baseColumnNames="schedule_transportation_id"
      baseTableName="cancel_reasons" constraintName="FK_CANCEL_REASONS_ON_SCHEDULE_TRANSPORTATION"
      referencedColumnNames="id" referencedTableName="schedule_transportations"/>
  </changeSet>
  <changeSet id="1765645557670-9" author="mauro">
    <addForeignKeyConstraint baseColumnNames="reason_id" baseTableName="reject_reasons"
      constraintName="FK_REJECT_REASONS_ON_REASON" referencedColumnNames="id"
