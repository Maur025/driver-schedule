  </changeSet>
  <changeSet id="1765645557670-10" author="mauro">
    <addForeignKeyConstraint baseColumnNames="transportation_request_id"
      baseTableName="reject_reasons" constraintName="FK_REJECT_REASONS_ON_TRANSPORTATION_REQUEST"
      referencedColumnNames="id" referencedTableName="transportation_requests"/>
  </changeSet>
  <changeSet id="1765645557670-11" author="mauro">
    <addForeignKeyConstraint baseColumnNames="reason_id" baseTableName="reschedule_reasons"
      constraintName="FK_RESCHEDULE_REASONS_ON_REASON" referencedColumnNames="id"
      referencedTableName="reasons"/>
  </changeSet>
  <changeSet id="1765645557670-12" author="mauro">
    <addForeignKeyConstraint baseColumnNames="schedule_transportation_id"
      baseTableName="reschedule_reasons"
      constraintName="FK_RESCHEDULE_REASONS_ON_SCHEDULE_TRANSPORTATION" referencedColumnNames="id"
      referencedTableName="schedule_transportations"/>
  </changeSet>

</databaseChangeLog>