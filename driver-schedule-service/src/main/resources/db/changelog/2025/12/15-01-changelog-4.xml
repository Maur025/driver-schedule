    <addNotNullConstraint columnName="person_requested_id" tableName="schedule_transportations"/>
  </changeSet>
  <changeSet id="1765812074880-3" author="mmoya@PragmaInvest.com">
    <addForeignKeyConstraint baseColumnNames="person_requested_id"
      baseTableName="schedule_transportations"
      constraintName="FK_SCHEDULE_TRANSPORTATIONS_ON_PERSON_REQUESTED" referencedColumnNames="id"
      referencedTableName="person"/>
  </changeSet>

</databaseChangeLog>