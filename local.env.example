LOGGING_LEVEL=info
SPRING_PROFILES_ACTIVE=dev

# == MAIN CONFIG ==
DB_HOST=localhost
DB_PORT=5540
DB_NAME=driver_schedule_db
DB_USERNAME=your-user
DB_PASSWORD=your-pass
SERVER_PORT_APP=7801
APP_SERVER_URL=http://localhost:7801

# == AUTH CONFIG ==

DB_HOST_AUTH=localhost
DB_PORT_AUTH=5541
DB_NAME_AUTH=driver_schedule_auth_db
DB_USERNAME_AUTH=your-user
DB_PASSWORD_AUTH=your-pass
SERVER_PORT_AUTH=7800
APP_SERVER_URL_AUTH=http://localhost:7800
APP_CORS_ALLOWED_ORIGINS_AUTH=http://localhost:4200

# == OAUTH2 CONFIG ==
OAUTH2_JWT_SECRET=your-secret-key
# openssl rand -base64 32
OAUTH2_JWT_AUDIENCE=driver.schedule.api
OAUTH2_JWT_ACCESS_TOKEN_EXP=1
OAUTH2_JWT_ACCESS_TOKEN_EXP_TYPE=hours
OAUTH2_JWT_REFRESH_TOKEN_EXP=7
OAUTH2_JWT_REFRESH_TOKEN_EXP_TYPE=days
OAUTH2_JWT_REFRESH_TOKEN_SECURE=dev #values dev or prod
OAUTH2_ADMIN_PASSWORD=your-pass

# == MICROSERVICES CONFIG ==
MS_AUTH_SCHEME=http
MS_AUTH_HOST=localhost
MS_AUTH_PORT=443

# == FIREBASE CONFIG ==
FIREBASE_CONNECTION_TIMEOUT=5000
FIREBASE_READ_TIMEOUT=10000
FIREBASE_TYPE=service_account
FIREBASE_PROJECT_ID=project-id
FIREBASE_PRIVATE_KEY_ID=private-key-id
FIREBASE_PRIVATE_KEY=private-key
FIREBASE_CLIENT_EMAIL=client-email
FIREBASE_CLIENT_ID=client-id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_X509_CERT_URL=client-x509-cert-url
FIREBASE_UNIVERSE=googleapis.com