LOGGING_LEVEL=info
SPRING_PROFILES_ACTIVE=dev

DB_HOST=localhost
DB_PORT=5540
DB_NAME=driver_schedule_db
DB_USERNAME=your-user
DB_PASSWORD=your-pass

SERVER_PORT_APP=7801
APP_SERVER_URL=http://localhost:7801

# == AUTH CONFIG ==

DB_HOST_AUTH=localhost
DB_PORT_AUTH=5541
DB_NAME_AUTH=driver_schedule_auth_db
DB_USERNAME_AUTH=your-user
DB_PASSWORD_AUTH=your-pass

SERVER_PORT_AUTH=7800
APP_SERVER_URL_AUTH=http://localhost:7800

OAUTH2_JWT_SECRET=your-secret-key
OAUTH2_JWT_AUDIENCE=driver.schedule.api
OAUTH2_JWT_ACCESS_TOKEN_EXP=1
OAUTH2_JWT_ACCESS_TOKEN_TYPE_EXP=hours
OAUTH2_JWT_REFRESH_TOKEN_EXP=7
OAUTH2_JWT_REFRESH_TOKEN_TYPE_EXP=days
OAUTH2_JWT_REFRESH_TOKEN_SECURE=dev #values dev or prod
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200
OAUTH2_ADMIN_PASSWORD=your-pass